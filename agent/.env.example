AGENT_ID=name
# Generate a different random credential for every agent.
AGENT_TOKEN=replace-with-a-unique-long-random-token
# Shared only while registering a new agent; it is ignored on later connections.
AGENT_ENROLLMENT_TOKEN=replace-with-the-server-enrollment-token

SERVER_WS_AGENT_URL=ws://127.0.0.1:8000/ws/agent

DRY_RUN=false
WS_HEARTBEAT_INTERVAL=10
