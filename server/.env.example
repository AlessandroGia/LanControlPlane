APP_ENV=production

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

DATABASE_URL=sqlite:////app/server/data/lan_control_plane.db

ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_SECURE=true
SESSION_TOUCH_INTERVAL_SECONDS=300
AGENT_OFFLINE_AFTER_SECONDS=60
METRICS_RETENTION_DAYS=30

AGENT_ENROLLMENT_TOKEN=

WOL_HELPER_BASE_URL=http://host.docker.internal:8099
WOL_HELPER_TOKEN=
WOL_BROADCAST_IP=255.255.255.255
WOL_PORT=9

CORS_ORIGINS=["http://localhost:3000","https://control.example.com"]
